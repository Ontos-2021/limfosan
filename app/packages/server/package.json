{
  "name": "@limfosan/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de la plataforma de juegos de cartas (Truco primero)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build -w @limfosan/juego-truco && npm run build -w @limfosan/shared && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@limfosan/juego-truco": "^0.1.0",
    "@limfosan/shared": "^0.1.0",
    "argon2": "^0.44.0",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
