# Ejemplo de entorno local (copiar a .env, nunca commitear secretos reales).
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=0.1.0-dev
COMMIT_SHA=local
DATABASE_URL=postgres://truco:truco@127.0.0.1:5433/truco
TEST_DATABASE_URL=postgres://truco:truco@127.0.0.1:5433/truco_test
SESSION_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios
SESSION_TTL_DAYS=30
REQUIRE_INVITE=true
ADMIN_EMAIL=admin@ejemplo.local
ADMIN_BOOTSTRAP_CODE=CAMBIA-ESTO-UNA-SOLA-VEZ
EMAIL_FROM=Mesa <hola@ejemplo.local>
# RESEND_API_KEY=
TURN_PLAY_SECONDS=60
TURN_RESPOND_SECONDS=30
GRACE_SECONDS=45
MAX_RECONNECTS=5
ALLOW_INSECURE_COOKIES=1
